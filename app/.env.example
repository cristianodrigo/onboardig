# Copie para .env e preencha.
# Sem AZURE_STORAGE_CONNECTION_STRING o app usa a pasta local uploads/.

PORT=8765
SESSION_SECRET=troque-por-um-segredo-longo
COOKIE_SECURE=false

# Postgres. Local: suba com docker compose up -d na raiz do repositório.
DATABASE_URL=postgres://onboarding:onboarding@localhost:5432/onboarding

# Primeiro usuário RH (só se o banco estiver vazio)
SEED_RH_NOME=RH
SEED_RH_EMAIL=
SEED_RH_PASSWORD=

# URL pública (links de convite nos e-mails)
PUBLIC_BASE_URL=https://onboarding.grupogci.com.br

# SMTP (Microsoft 365: smtp.office365.com, porta 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=GCI — Onboarding

# Cole a CONNECTION STRING inteira (Access keys → key1 → Connection string → Show → Copy)
# NÃO cole só a "Key". Tem que começar com DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documentos
