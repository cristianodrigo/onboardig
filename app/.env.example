# Copie para .env e preencha.
# Sem AZURE_STORAGE_CONNECTION_STRING o app usa a pasta local uploads/.

PORT=8765
SESSION_SECRET=onboardig-prototipo-dev

# Cole a CONNECTION STRING inteira (Access keys → key1 → Connection string → Show → Copy)
# NÃO cole só a "Key". Tem que começar com DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documentos
